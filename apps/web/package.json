{
  "name": "sales-manager-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
