# Keep reproducible dependencies and documentation in Git:
# package-lock.json / pnpm-lock.yaml / yarn.lock / uv.lock / poetry.lock
# .terraform.lock.hcl / sanitized *.example files / synthetic CSV fixtures
# .gitignore cannot protect secrets already tracked by Git.
